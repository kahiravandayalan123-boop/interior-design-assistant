# Copy this file to .env and fill in real values when you have them.
# The app starts fine with these left blank — API calls fall back to mock
# responses so you can exercise the full flow before wiring real keys.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides (defaults shown)
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024

# low | medium | high — medium renders noticeably faster
OPENAI_IMAGE_QUALITY=high
# Per-call timeouts in seconds (Claude call / image render)
ANTHROPIC_TIMEOUT=45
OPENAI_IMAGE_TIMEOUT=150

# Comma-separated list of origins allowed to call this API (the Vite dev
# server locally; your Vercel URL in production, e.g. https://x.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for extra origins, e.g. Vercel preview deploys:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Force mock responses even when keys are present (useful for offline dev)
FORCE_MOCK=false
